---
const {name,alt,width,height,sizes='(max-width: 767px) 100vw, 1200px',class:className='',eager=false}=Astro.props;
---
<picture class={className}><source type="image/webp" srcset={[480,800,1200,1920].filter(w=>w<=width).map(w=>`/assets/${name}-${w}.webp ${w}w`).join(', ')} sizes={sizes} /><img src={`/assets/${name}.webp`} alt={alt} width={width} height={height} loading={eager?'eager':'lazy'} decoding="async" sizes={sizes} /></picture>
